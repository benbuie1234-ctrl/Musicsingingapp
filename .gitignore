# --- Audio: never commit copyrighted source material or derived stems ---
# This repo is public. Reference tracks stay local; only note maps ship.
*.m4a
*.mp3
*.wav
*.flac
*.aiff
*.aif
*.ogg
*.opus
separated/
separated-ft/
stems/
audio/

# Derived pitch maps for third-party songs also stay local. A contour is a
# machine-readable transcription of a copyrighted melody -- closer to sheet
# music than to analysis -- and this repo is public. Maps for your own songs
# can be force-added.
web/public/maps/*.json

# Album art is extracted from the tracks themselves, so it is copyrighted too.
web/art/
web/songs.local.json

# --- Python ---
.venv/
venv/
__pycache__/
*.pyc
.python-version

# --- Node ---
node_modules/
dist/
.wrangler/

# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Editors ---
.vscode/
.idea/

# --- Local config / secrets ---
.env
.env.*
!.env.example
.dev.vars
.devcert.*
